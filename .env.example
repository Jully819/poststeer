# Demo booking emails (lib/booking.ts).
#
# The site is a static export, so these are read at BUILD time and inlined into
# the bundle: change one and rebuild. NEXT_PUBLIC_ means public — only use keys
# that are meant to be seen, which is what EmailJS's public key is for.
#
# Setup, once, at https://dashboard.emailjs.com:
#  1. Add an email service (Gmail works) and copy its Service ID.
#  2. Account -> General: copy the Public Key.
#  3. Create two templates. Set each one's "To Email" field to {{to_email}}.
#     Both receive: name, email, goal, website, phone, sms_opt_in, guests,
#     slot, timezone, starts_at, ends_at, duration, calendar_link, team_email.
#     - client template: the visitor's confirmation.
#     - team template:   the copy for the address below. Put {{calendar_link}}
#       in it; clicking it saves the slot to Google Calendar with the visitor
#       already invited.
#  4. Copy this file to .env.local, fill in the four IDs, and rebuild.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_ajlxp1d
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=qLtFcBSegsP3Wfdm_
NEXT_PUBLIC_EMAILJS_TEMPLATE_CLIENT=template_xg6u8in
NEXT_PUBLIC_EMAILJS_TEMPLATE_TEAM=template_613x6yq

# Where the team's copy lands. Defaults to this if unset.
NEXT_PUBLIC_BOOKING_EMAIL=poststeer@gmail.com
