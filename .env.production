# Build-time config for the deployed site. Committed on purpose.
#
# Next loads this file for `next build`, which is what CI runs. These four are
# EmailJS's public identifiers: `output: 'export'` inlines them into the
# JavaScript bundle, so every visitor's devtools shows them whatever we do
# here. Keeping them in the repo costs nothing extra in secrecy.
#
# WHAT PROTECTS THE ACCOUNT IS THE ORIGIN ALLOWLIST, not this file. Restrict
# Allowed Origins in the EmailJS dashboard to the site's own domains, or
# anyone can spend the monthly send quota through these templates.
#
# Never add a private key, an API secret or a Gmail password here. Those do
# not belong in a static export at all, since it has no server to hide them.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_ajlxp1d
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=qLtFcBSegsP3Wfdm_
NEXT_PUBLIC_EMAILJS_TEMPLATE_CLIENT=template_xg6u8in
NEXT_PUBLIC_EMAILJS_TEMPLATE_TEAM=template_613x6yq
NEXT_PUBLIC_EMAILJS_TEMPLATE_BRIEF=

NEXT_PUBLIC_BOOKING_EMAIL=poststeer@gmail.com
